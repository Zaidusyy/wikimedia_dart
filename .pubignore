# Files to ignore when publishing to pub.dev

# Local IDE and tool configuration files
.dart_tool/
.github/
pubspec.lock

# Test coverage output
coverage/

# Repository-only documentation
doc/release_checklist.md
doc/real_world_validation.md

# Local working files and environment (already gitignored; listed here because
